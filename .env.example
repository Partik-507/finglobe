# ──────────────────────────────────────────────────────────────────
# FINGLOBE — Environment Variables
# Copy this file to .env (root), backend/.env, frontend/.env.local
# ──────────────────────────────────────────────────────────────────

# ── Blockchain (contracts + backend) ──────────────────────────────
# Your wallet private key (WITHOUT 0x prefix) — for contract deployment
PRIVATE_KEY=your_private_key_here

# Polygon Amoy RPC (public or Alchemy/Infura endpoint)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# PolygonScan API key (optional — for contract verification)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_optional

# ── IPFS (backend) ─────────────────────────────────────────────────
# Pinata JWT token — get free at https://pinata.cloud
# If not set, backend runs in mock mode (still works for demo)
PINATA_JWT=your_pinata_jwt_here

# ── Cryptography (backend) ────────────────────────────────────────
# 32-byte (64 hex chars) AES-256-GCM encryption key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ── Backend Config ─────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (Next.js — prefix with NEXT_PUBLIC_) ─────────────────
# Set this AFTER deploying the contract
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
